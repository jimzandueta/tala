{
  "name": "@jimzandueta/tala",
  "version": "0.1.6",
  "description": "TALA — Technical Analysis Library for Assets. TypeScript, tree-shakeable, zero runtime deps.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "stocks",
    "technical-analysis",
    "indicators",
    "trading",
    "SMA",
    "EMA",
    "MACD",
    "RSI",
    "CCI",
    "ADX",
    "ALMA",
    "stochastic",
    "fibonacci",
    "pivot",
    "williams",
    "typescript"
  ],
  "author": "Jim Zandueta",
  "license": "ISC",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimzandueta/tala.git"
  },
  "bugs": {
    "url": "https://github.com/jimzandueta/tala/issues"
  },
  "homepage": "https://github.com/jimzandueta/tala#readme"
}
